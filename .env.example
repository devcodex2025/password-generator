# Google Tag Manager ID (e.g. GTM-XXXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Bearer token to protect /api/content-health (leave empty to allow unauthenticated access)
CONTENT_HEALTH_TOKEN=

# Content source mode
# json (default) | database | mongodb
CONTENT_SOURCE=json

# Database connection (set one of these for database mode)
# Preferred generic variable:
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Optional alias supported by this project:
SUPABASE_DB_URL=

# SSL options:
# - For Supabase you can leave this empty (SSL auto-enabled by host detection).
# - Set explicitly to true/false to override.
DATABASE_SSL=

# Optional Supabase API keys (only needed if you later use supabase-js in app code)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NordPass Affiliate URLs
# Real tracking links go in src/content/affiliate/links.json (per locale / per geo).
# These env vars are a global fallback for every locale — do not use them to hide
# a missing per-locale mapping in production.
NEXT_PUBLIC_NORDPASS_AFFILIATE_URL=https://nordpass.com
NEXT_PUBLIC_NORDPASS_B2B_AFFILIATE_URL=https://nordpass.com/business

# Other Nord products (same rule: real links live in links.json)
NEXT_PUBLIC_NORDVPN_AFFILIATE_URL=
NEXT_PUBLIC_NORDLOCKER_AFFILIATE_URL=
NEXT_PUBLIC_SAILY_AFFILIATE_URL=
NEXT_PUBLIC_INCOGNI_AFFILIATE_URL=

# ─────────────────────────────────────────────────────────────
# SECRETS — server only. Never prefix these with NEXT_PUBLIC_,
# never put them in links.json, never commit them.
# Local development: .env.local (gitignored).
# Production: Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────
# Nord affiliate portal (HasOffers) API key, only needed for automated reports
NORD_AFFILIATE_API_KEY=
NORD_AFFILIATE_NETWORK_ID=nordvpn
NORD_AFFILIATE_ID=

# GA4 service-account key for `npm run ga4` / `npm run affiliate` (path outside the repo)
GA4_CREDENTIALS=

# Phase 2: push affiliate conversions into GA4 as `purchase` events
# Measurement ID and the Measurement Protocol secret (GA4 → Admin → Data streams → API secrets)
GA4_MEASUREMENT_ID=
GA4_MP_API_SECRET=
# Bearer token for /api/affiliate/sync; Vercel Cron sends it automatically
CRON_SECRET=

# MongoDB content source (used when CONTENT_SOURCE=mongodb)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=generatepassword
MONGODB_COLLECTION=content_guides

# ─────────────────────────────────────────────────────────────
# CDN / Cloudflare (optional). See docs/cloudflare-setup.md.
# Set to true only when the production domain is proxied through
# Cloudflare (orange cloud) and Cloudflare IP Geolocation is enabled.
# Leave false so the app trusts only Vercel's geo header.
TRUST_CF_IPCOUNTRY=false

# ─────────────────────────────────────────────────────────────
# Docker Compose (optional). See "Optional: Docker Compose" in README.md.
# Host ports for the Caddy HTTPS proxy.
HTTP_PORT=80
HTTPS_PORT=443
# Hostname Caddy serves. localhost = local CA certificate;
# a public domain = Let's Encrypt (needs public ports 80 and 443).
SITE_ADDRESS=localhost
