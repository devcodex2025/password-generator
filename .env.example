# Content source mode
# json (default) | database | mongodb
CONTENT_SOURCE=json

# Database connection (set one of these for database mode)
# Preferred generic variable:
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Optional alias supported by this project:
SUPABASE_DB_URL=

# SSL options:
# - For Supabase you can leave this empty (SSL auto-enabled by host detection).
# - Set explicitly to true/false to override.
DATABASE_SSL=

# Optional Supabase API keys (only needed if you later use supabase-js in app code)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MongoDB content source (used when CONTENT_SOURCE=mongodb)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=generatepassword
MONGODB_COLLECTION=content_guides
